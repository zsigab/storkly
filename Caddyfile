# Redirect www → apex
www.storkly.cc {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
    redir https://storkly.cc{uri} permanent
}

# Production — storkly.cc
storkly.cc {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
    handle /api/* {
        reverse_proxy api:8080
    }
    handle /uploads/* {
        reverse_proxy api:8080
    }
    handle /oauth2/* {
        reverse_proxy api:8080
    }
    handle /login/oauth2/* {
        reverse_proxy api:8080
    }
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
