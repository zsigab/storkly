# Production — storkly.app
storkly.app {
    handle /api/* {
        reverse_proxy api:8080
    }
    handle /oauth2/* {
        reverse_proxy api:8080
    }
    handle /login/oauth2/* {
        reverse_proxy api:8080
    }
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
