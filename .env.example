# ── Spring ─────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Database ───────────────────────────────────────────────────────────────
DB_USER=storkly
DB_PASSWORD=changeme

# ── JWT ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-48-plus-character-secret

# ── Cloudflare Turnstile CAPTCHA ───────────────────────────────────────────
# Get from: https://dash.cloudflare.com/ → Turnstile
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Brevo (email) ──────────────────────────────────────────────────────────
# Get from: https://app.brevo.com/settings/keys/smtp
BREVO_USERNAME=your-brevo-login-email
BREVO_PASSWORD=your-brevo-smtp-api-key

# ── Google OAuth ───────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URIs to register:
#   Local:  http://localhost:8081/login/oauth2/code/google
#   Prod:   https://storkly.app/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Data Seeding (local dev only) ──────────────────────────────────────────
# Set to true to seed sample registries, items, and claims on startup
# STORKLY_SEED_DATA=true
