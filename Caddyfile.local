# Local Colima (preprod) — no TLS
:8080 {
    handle /api/* {
        reverse_proxy api:8081
    }
    handle /uploads/* {
        reverse_proxy api:8081
    }
    handle /oauth2/* {
        reverse_proxy api:8081
    }
    handle /login/oauth2/* {
        reverse_proxy api:8081
    }
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
